# ─────────────────────────────
# Application
# ─────────────────────────────
# Port your Node server will listen on (mapped in docker-compose.yml)
PORT=3000

# Node environment: usually "development" or "production"
NODE_ENV=development

# ─────────────────────────────
# Database (Postgres)
# ─────────────────────────────
# These must match the values in docker-compose.yml → db service
POSTGRES_USER=projectO
POSTGRES_PASSWORD=Pass1234
POSTGRES_DB=projectO

# URL used by Docker containers (note host = "db", the service name in compose)
DOCKER_DATABASE_URL=postgresql://projectO:Pass1234@db:5432/projectO?schema=public

# URL used when running the server directly on your host (no Docker)
DATABASE_URL=postgresql://projectO:Pass1234@localhost:5432/projectO?schema=public

# ─────────────────────────────
# OpenAI
# ─────────────────────────────
# Get one from: https://platform.openai.com
OPENAI_API_KEY=your-openai-api-key-here
